{
  "name": "dragref",
  "version": "0.1.0",
  "description": "Drag references (and optional JSON or files) out of a web page into AI clients like Claude, Cursor, and ChatGPT.",
  "keywords": [
    "drag-and-drop",
    "dataTransfer",
    "react",
    "nextjs",
    "llm",
    "ai",
    "claude",
    "chatgpt",
    "cursor"
  ],
  "license": "MIT",
  "author": "Adam Conway <adam@theoryvc.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheoryVentures/dragref.git",
    "directory": "packages/dragref"
  },
  "homepage": "https://github.com/TheoryVentures/dragref/tree/main/packages/dragref#readme",
  "bugs": "https://github.com/TheoryVentures/dragref/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:package": "publint --strict && attw --pack . --profile node16",
    "prepublishOnly": "pnpm run build && pnpm run test && pnpm run check:package"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.1",
    "publint": "0.3.24",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
