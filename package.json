{
  "name": "dragref-monorepo",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "pnpm --filter \"./packages/*\" build && pnpm --filter playground dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter \"./packages/*\" build && pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "typescript": "5.9.3"
  }
}
